rules_version = '2';

// Recommended additions for the Live Classroom system.
// Merge these match blocks into the existing Firestore rules.
// Do NOT replace the rest of the production rules file blindly.

service cloud.firestore {
  match /databases/{database}/documents {
    // Live class metadata and OBS secrets must not be readable from the client.
    // Students and staff receive metadata through Next.js API routes after
    // Firebase Auth + enrollment checks. Playback URLs are short-lived tokens.
    match /live_classes/{liveClassId} {
      allow read, write: if false;
    }

    match /live_class_secrets/{liveClassId} {
      allow read, write: if false;
    }

    // Existing student-copied class documents can remain readable by the owner
    // for legacy Google Meet / external-link classes only.
    match /students/{studentId}/classes/{classId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid
        || request.auth != null && exists(/databases/$(database)/documents/students/$(studentId))
           && get(/databases/$(database)/documents/students/$(studentId)).data.uid == request.auth.uid;
      allow write: if false;
    }
  }
}
