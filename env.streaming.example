# Copy these into your real .env.local. Do not commit secrets.

# Firebase Admin (server-side student verification)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Cloudflare Stream (recommended provider)
STREAMING_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=
CLOUDFLARE_STREAM_ALLOWED_ORIGINS=vit.vivexatech.in,localhost,127.0.0.1

# Optional: sign playback JWTs locally instead of calling Cloudflare /token
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=

# Optional webhook protection
CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# Allow these emails to create and schedule live classes
PORTAL_STAFF_EMAILS=teacher@example.com
